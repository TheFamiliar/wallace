{
  "meta": {
    "name": "Wallace",
    "version": "3.0.0",
    "license": "MPL-2.0",
    "description": "Single source of truth for the Wallace palette and role map. Apps formats are emitted from this file by generate.py. Derivation: see '1 Main colour palettes/Wallace Palette Derivation.md'.",
    "origin": {
      "l": 0.5,
      "c": 0.11,
      "h": 150
    },
    "step": 0.087,
    "formula": {
      "ramp": "L(k) = origin.l + k * step, k = -4..+4, at C=0.11 H=150",
      "accentRow": "oklch(L(step) 0.11 hue) for hue = 0,30,...,330; grey at C=0",
      "step": "smallest uniform interval where every hue 6 steps above the background reaches 7:1 (AAA); 5 steps then gives 4.5:1 (AA) for every hue",
      "gamut": "colours outside sRGB are fitted with coloraide fit('srgb', method='lch-chroma') -- later coloraide releases changed the default fit, so name it explicitly; hexes below are the fitted, verified values"
    }
  },
