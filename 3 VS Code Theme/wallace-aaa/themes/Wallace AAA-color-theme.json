{
	"name": "Wallace AAA",
	"type": "dark",
	"colors": {
		"editor.background": "#003100",
		"editor.foreground": "#76d25d",
		"editor.lineHighlightBackground": "#002700",
		"editor.selectionBackground": "#004600",
		"editorCursor.foreground": "#aaff8d",
		"editorWhitespace.foreground": "#006a00"
	},
	"tokenColors": [
		{
			"settings": {
				"foreground": "#85D000",
				"background": "#003100"
			}
		},
		{
			"name": "Comment", //+
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#278915"
			}
		},
		{
			"name": "Variables",
			"scope": [
				"variable",
				"string constant.other.placeholder"
			],
			"settings": {
				"foreground": "#C0C334"
				"foreground": "#FF95F4"
			}
		},
		{
			"name": "Colors",
			"scope": [
                "constant.other.color",
                "constant.other.color.rgb-value.hex.css"
			],
			"settings": {
				"foreground": "#F1B054"
				"foreground": "#BBBBBB"
			}
		},
		{
			"name": "Invalid",
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#FFA87F"
			}
		},
		{
			"name": "Keyword, Storage", //+
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#1BD2B8"
			}
		},
		{
			"name": "Operator, Misc", //+
			"scope": [
				"keyword.control",
				"punctuation",
				"meta.tag",
				"punctuation.definition.tag",
                "punctuation.separator.inheritance.php",
                "keyword.operator.key.php",
                "keyword.operator.assignment.php",
				"punctuation.definition.tag.html",
				"punctuation.section.embedded",
				"keyword.other.template",
                "keyword.other.substitution",
                "keyword.other.important",
                "keyword.other.default.scss",
				"punctuation.definition.tag.begin.html",
				"punctuation.definition.tag.end.html"
			],
			"settings": {
				"foreground": "#BCBCBC"
			}
        },
        {
            "name": "PHP", //+
            "scope": [
                "punctuation.section.embedded.begin.php",
                "punctuation.section.embedded.end.php",
                "storage.type.function.php",
                "storage.modifier.php"
            ],
            "settings": {
                "foreground": "#00CAFF"
            }
        },
        {
            "name": "PHP Keywords", //+
            "scope": [
                "keyword.control.return.php",
                "constant.other.php"
            ],
            "settings": {
                "foreground": "#E5A2FF"
            }
        },
		{
			"name": "Tag", //+
			"scope": [
				"entity.name.tag",
				"meta.tag.sgml",
                "markup.deleted.git_gutter",
                "entity.tag.apacheconf"
			],
			"settings": {
                //"fontStyle": "bold",
				"foreground": "#00D696"
			}
		},
		{
			"name": "Function, Special Method", //+
			"scope": [
