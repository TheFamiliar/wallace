			"settings": {
				"foreground": "#6EC4FD"
			}
		},
		{
			"name": "Other Variable, String Link", //+
			"scope": [
				"support.other.variable",
				"string.other.link"
			],
			"settings": {
				"foreground": "#FF95F4"
			}
		},
