				"meta.function-call",
				"variable.function",
				"support.function",
				"keyword.other.special-method"
			],
			"settings": {
				"foreground": "#C8ACFF"
			}
		},
		{
			"name": "Block Level Variables", //+
			"scope": [
				"meta.block variable.other"
