# Wallace themes for delta (https://github.com/dandavison/delta)
# Generated by generate.py - do not edit by hand.
#
# Wallace bans red: deletions are magenta, additions green.
#
# Install:
#   1. Save/symlink this file, then in ~/.gitconfig add:
#        [include]
#            path = /path/to/wallace.gitconfig
#        [delta]
#            features = wallace-aa        # or wallace-aaa
#   2. syntax-theme needs the Wallace bat theme installed:
#        mkdir -p "$(bat --config-dir)/themes"
#        cp "7 CLI Themes/Wallace AA.tmTheme" "$(bat --config-dir)/themes/"
#        bat cache --build

[delta "wallace-aa"]
    dark = true
    # requires the matching bat theme: see wallace-fzf-and-cli-readme below
    syntax-theme = Wallace AA
    minus-style = "#bd7db7" "#001300"
    minus-emph-style = bold "#002909" "#bd7db7"
    plus-style = syntax "#001300"
    plus-emph-style = bold "#002909" "#61a972"
    line-numbers = true
    line-numbers-minus-style = "#bd7db7"
    line-numbers-plus-style = "#61a972"
    line-numbers-zero-style = "#2b7440"
    line-numbers-left-style = "#2b7440"
    line-numbers-right-style = "#2b7440"
    file-style = bold "#30ac99"
    file-decoration-style = ul "#2b7440"
    hunk-header-style = "#969696"
    hunk-header-decoration-style = "#2b7440" box
    commit-style = bold "#c8854c"
    whitespace-error-style = reverse "#bd7db7"
    blame-palette = "#002909" "#001300" "#004211"

[delta "wallace-aaa"]
    dark = true
    # requires the matching bat theme: see wallace-fzf-and-cli-readme below
    syntax-theme = Wallace AAA
    minus-style = "#d998d3" "#001300"
    minus-emph-style = bold "#002909" "#d998d3"
    plus-style = syntax "#001300"
    plus-emph-style = bold "#002909" "#7cc58c"
    line-numbers = true
    line-numbers-minus-style = "#d998d3"
    line-numbers-plus-style = "#7cc58c"
    line-numbers-zero-style = "#2b7440"
    line-numbers-left-style = "#2b7440"
    line-numbers-right-style = "#2b7440"
    file-style = bold "#53c8b4"
    file-decoration-style = ul "#2b7440"
    hunk-header-style = "#b1b1b1"
    hunk-header-decoration-style = "#2b7440" box
    commit-style = bold "#e5a067"
    whitespace-error-style = reverse "#d998d3"
    blame-palette = "#002909" "#001300" "#004211"
