# Wallace themes for delta (https://github.com/dandavison/delta)
# Generated by generate.py - do not edit by hand.
#
# Wallace bans red: deletions are magenta, additions green.
#
# Install:
#   1. Save/symlink this file, then in ~/.gitconfig add:
#        [include]
#            path = /path/to/wallace.gitconfig
#        [delta]
#            features = wallace-aa        # or wallace-aaa
#   2. syntax-theme needs the Wallace bat theme installed:
#        mkdir -p "$(bat --config-dir)/themes"
#        cp "7 CLI Themes/Wallace AA.tmTheme" "$(bat --config-dir)/themes/"
#        bat cache --build

[delta "wallace-aa"]
    dark = true
    # requires the matching bat theme: see wallace-fzf-and-cli-readme below
    syntax-theme = Wallace AA
    minus-style = "#a869a2" "#000300"
    minus-emph-style = bold "#001901" "#a869a2"
    plus-style = syntax "#000300"
    plus-emph-style = bold "#001901" "#4d955f"
    line-numbers = true
    line-numbers-minus-style = "#a869a2"
    line-numbers-plus-style = "#4d955f"
    line-numbers-zero-style = "#2b7440"
    line-numbers-left-style = "#2b7440"
    line-numbers-right-style = "#2b7440"
    file-style = bold "#039885"
    file-decoration-style = ul "#2b7440"
    hunk-header-style = "#838383"
    hunk-header-decoration-style = "#2b7440" box
    commit-style = bold "#b27238"
    whitespace-error-style = reverse "#a869a2"
    blame-palette = "#001901" "#000300" "#00360c"

[delta "wallace-aaa"]
    dark = true
    # requires the matching bat theme: see wallace-fzf-and-cli-readme below
    syntax-theme = Wallace AAA
    minus-style = "#cb8ac5" "#000300"
    minus-emph-style = bold "#001901" "#cb8ac5"
    plus-style = syntax "#000300"
    plus-emph-style = bold "#001901" "#6fb77f"
    line-numbers = true
    line-numbers-minus-style = "#cb8ac5"
    line-numbers-plus-style = "#6fb77f"
    line-numbers-zero-style = "#2b7440"
    line-numbers-left-style = "#2b7440"
    line-numbers-right-style = "#2b7440"
    file-style = bold "#42baa6"
    file-decoration-style = ul "#2b7440"
    hunk-header-style = "#a4a4a4"
    hunk-header-decoration-style = "#2b7440" box
    commit-style = bold "#d69359"
    whitespace-error-style = reverse "#cb8ac5"
    blame-palette = "#001901" "#000300" "#00360c"
